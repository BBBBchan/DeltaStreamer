# Copy to demo/.env. Never commit the copy or your API key.
DEMO_BACKEND=local
DEMO_API_BASE_URL=http://127.0.0.1:8000/v1
DEMO_API_KEY=
DEMO_MODEL=DeltaStreamer-VLM
# For Qwen served by vLLM. Remote providers may require {} or another option.
DEMO_EXTRA_BODY_JSON='{"chat_template_kwargs":{"enable_thinking":false}}'
DEMO_API_TIMEOUT=180
DEMO_MAX_TOKENS=4096
DEMO_MAX_PIXELS=100352
DEMO_MAX_UPLOAD_MB=512
DEMO_MAX_DURATION_SECONDS=300
DEMO_MAX_MODEL_CALLS=600
# Optional. Defaults to demo/.data and is excluded from git.
# DEMO_DATA_DIR=/absolute/path/to/demo-data
