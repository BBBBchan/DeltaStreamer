DEMO_BACKEND=remote
DEMO_API_BASE_URL=https://your-provider.example/v1
DEMO_API_KEY=replace-with-your-key
DEMO_MODEL=your-vision-model-id
# Use only provider-supported options. Two-image input must be supported.
DEMO_EXTRA_BODY_JSON='{}'
DEMO_API_TIMEOUT=180
DEMO_MAX_TOKENS=4096
DEMO_MAX_PIXELS=100352
DEMO_MAX_UPLOAD_MB=512
DEMO_MAX_DURATION_SECONDS=300
DEMO_MAX_MODEL_CALLS=600
