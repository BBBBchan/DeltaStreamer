{
  "benchmark": "streamingbench",
  "dataset": "streamingbench_streamdelta_eval.json",
  "video_dir": "audio_videos",
  "tasks": "all",
  "environment": {
    "STREAMO_MAX_TOOL_CALLS_PER_REPLY": "5",
    "STREAMO_TRACKER_BACKEND": "sam2",
    "STREAMO_ASR_BACKEND": "whisper",
    "STREAMO_WHISPER_MODEL": "base",
    "STREAMO_WHISPER_DEVICE": "cpu",
    "STREAMO_ZOOM_DUP_IOU": "0.85",
    "STREAMO_CRR_CLUE_AUDIT_FPS": "4",
    "STREAMO_CRR_CLUE_AUDIT_WINDOW_SECONDS": "47.875",
    "STREAMO_ENFORCE_EAGER": "0",
    "STREAMO_GDN_PREFILL_BACKEND": "triton",
    "STREAMO_ENABLE_LOCUS_V2": "0",
    "STREAMO_ENABLE_SSR_LOCAL_AUDIT": "0",
    "STREAMO_ENABLE_CRR_TARGET_AUDIT": "0",
    "STREAMO_ENABLE_REC_SPORTS_CYCLE_V2": "0",
    "STREAMO_ENABLE_REC_SPORTS_CYCLE_V3": "0",
    "STREAMO_ENABLE_LISTED_REFUSAL_EVIDENCE_GATE": "0",
    "STREAMO_ENABLE_LISTED_REFUSAL_BIDIRECTIONAL_AUDIT": "0",
    "STREAMO_ENABLE_LISTED_REFUSAL_VISUAL_AUDIT": "0",
    "STREAMO_ENABLE_CURRENT_LOCUS_DUAL_VIEW_AUDIT": "0",
    "STREAMO_ENABLE_CURRENT_LOCUS_ITER39_PROTECTOR": "0",
    "STREAMO_ENABLE_EVENT_PREDICATE_AUDIT": "0",
    "STREAMO_ENABLE_CRR_CLUE_AUDIT": "0",
    "STREAMO_ENABLE_CRR_TYPED_RELATION_AUDIT": "0",
    "STREAMO_ENABLE_SEGMENTED_COUNT_AUDIT": "1",
    "STREAMO_SB_DENSE_CADENCE": "1",
    "STREAMO_SB_CAUSAL_HINT": "1"
  },
  "arguments": {
    "max_tool_calls_per_round": 3,
    "max_tool_calls_per_sample": 0,
    "max_tool_calls_per_reply": 5,
    "memory_mode": "brief",
    "memory_token_budget": 1500,
    "enable_memory_tools": true,
    "enable_track_tools": true,
    "enable_audio_tools": true,
    "enable_efficiency_tools": true,
    "budget_max_tool_calls": 24,
    "budget_max_frames_seen": 0,
    "budget_max_tokens": 200000,
    "auto_anchor_every": 5,
    "auto_asr_every": 10,
    "auto_asr_window": 10,
    "auto_track_query_every": 3,
    "memory_render_mode": "continuous",
    "memory_head_seconds": 0,
    "memory_tail_seconds": 20,
    "memory_recall_topk": 8,
    "cold_start_rounds": 4,
    "degrade_threshold": 2,
    "degrade_events_min": 12,
    "rolling_window": 3,
    "no_think": true,
    "delta_input_mode": "2frame",
    "enable_verification": true
  }
}
